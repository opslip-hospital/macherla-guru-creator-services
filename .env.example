# Copy to .env for local development. Never commit real values.
APP_ENV=development
APP_NAME=Macherla Guru Creator Services

# Authentication provider (not configured yet)
AUTH_ISSUER_URL=
AUTH_AUDIENCE=
AUTH_JWKS_URL=

# Database connection (use a managed PostgreSQL service with row-level security)
DATABASE_URL=

# Google OAuth - configure in Google Cloud Console before enabling customer connections
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8501/oauth/callback

# YouTube OAuth scopes should be limited to the minimum required.
# Do not add broad Google account scopes.

# Admin identity must come from verified authentication claims, not a user-editable form.
ADMIN_EMAIL_ALLOWLIST=
